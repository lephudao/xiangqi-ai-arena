# Copy file này thành .env.local rồi điền key của bạn.
#   cp .env.example .env.local
# .env.local đã được .gitignore chặn -> không bao giờ lọt lên GitHub.
# TUYỆT ĐỐI không điền key thật vào chính file .env.example này.

# --- API key các nhà cung cấp AI ---
# Để trống thì kỳ thủ đó tự chuyển sang chế độ Mock (đi ngẫu nhiên hợp lệ) và ghi rõ lý do.
# Không cần key nào cũng chạy được toàn bộ giao diện.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Code đã viết nhưng CHƯA kiểm chứng bằng key thật:
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Engine chấm điểm Pikafish ---
# Cài bằng: ./scripts/install-pikafish.sh
# Không có Pikafish thì trận vẫn đấu được, chỉ mất phần chấm điểm và thanh eval.
PIKAFISH_PATH=engine/bin/pikafish
PIKAFISH_NNUE_PATH=engine/bin/pikafish.nnue
PIKAFISH_MOVETIME_MS=300

# --- Máy chủ ---
# HOST=127.0.0.1 nghĩa là chỉ máy bạn truy cập được.
# Đổi thành 0.0.0.0 là mở ra toàn mạng — hệ thống này KHÔNG có xác thực,
# ai vào được cũng dùng được key của bạn. Chỉ đổi khi bạn hiểu rõ rủi ro.
HOST=127.0.0.1
PORT=5000
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Bật debugger Werkzeug. Nguy hiểm nếu máy chủ mở ra mạng ngoài -> để 0.
FLASK_DEBUG=0

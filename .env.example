# Xiangqi AI vs AI Studio Environment Configuration

# Optional API Keys (Leave blank to use Mock AI mode automatically)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server
PORT=5000
# Chỉ nghe local. Chỉ đổi thành 0.0.0.0 sau khi đã thêm xác thực.
HOST=127.0.0.1
# Bật debugger Werkzeug (=1). Nguy hiểm nếu server mở ra mạng ngoài.
FLASK_DEBUG=0
# Origin được phép gọi API (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
